{
  "gutter": 1,
  "id": "apex",
  "name": "Apex",
  "version": "0.1.0",
  "languages": [
    {
      "id": "apex",
      "name": "Apex",
      "extensions": ["cls", "trigger", "apex"],
      "filenames": [],
      "grammar": "grammars/apex.json",
      "lineComment": "//",
      "blockComment": ["/*", "*/"]
    }
  ],
  "servers": [
    {
      "id": "apex-jorje",
      "languages": ["apex"],
      "command": [
        "${setting:javaPath}",
        "-cp",
        "${setting:jarPath}",
        "-Xmx${setting:maxHeap}",
        "-Ddebug.internal.errors=true",
        "-Ddebug.semantic.errors=false",
        "-Ddebug.completion.statistics=false",
        "-Dlwc.typegeneration.disabled=true",
        "apex.jorje.lsp.ApexLanguageServerLauncher"
      ],
      "rootMarkers": ["sfdx-project.json"],
      "initializationOptions": { "enableEmbeddedSoqlCompletion": false },
      "install": [
        {
          "download": {
            "any": {
              "url": "https://raw.githubusercontent.com/forcedotcom/salesforcedx-vscode/5a804a968fc7412186121d7edc1f4d4fd142569f/packages/salesforcedx-vscode-apex/jars/apex-jorje-lsp.jar",
              "sha256": "4477f6c5e4c79bb7fe13e77cbcd77b25e0d4f5b730a7b4036b1031c274221d55"
            }
          },
          "to": "apex-jorje-lsp.jar"
        }
      ]
    }
  ],
  "settings": [
    { "key": "javaPath", "label": "Java", "type": "path", "default": "java" },
    {
      "key": "jarPath",
      "label": "apex-jorje-lsp.jar",
      "type": "path",
      "default": "${serverDir}/apex-jorje-lsp.jar"
    },
    { "key": "maxHeap", "label": "Server memory limit", "type": "text", "default": "1g" }
  ]
}
